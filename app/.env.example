# Server-side Supabase values for local tooling, Supabase CLI, or future
# server endpoints. Do not expose SUPABASE_SERVICE_ROLE_KEY in browser code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_FOR_SERVER_ONLY_TASKS

# Browser runtime config is loaded from env-config.js because DocScrub has no
# bundler or process.env injection. Copy env-config.example.js to
# env-config.js and fill in the matching browser-safe values.
